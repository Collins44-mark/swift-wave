# Public Supabase config (safe for NEXT_PUBLIC_*)
# Required in Vercel Production before `npm run build` (client bundle inlines these).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional server-only aliases (runtime on Vercel — useful for admin SSR without rebuild).
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# Legacy alias also supported: SUPABASE_ANON_KEY=

# Server-only Supabase service role — NEVER use NEXT_PUBLIC_ for this.
# Required to create/delete Auth users from Super Admin user management.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary — cloud name + API key are used by the signed upload widget
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=

# Cloudinary API secret — SERVER ONLY. Never use NEXT_PUBLIC_ for this.
CLOUDINARY_API_SECRET=

# Optional: signed upload preset name (if you create one in Cloudinary Dashboard)
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# Local CLI / migration only — never expose to the browser
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_PASSWORD=
